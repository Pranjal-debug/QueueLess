  database: 'mmXIjNZgOPFyOb1tPy9vF0sOnopDNOSg'
  # Matches redis password in docker-compose.yaml
  redis: '3niID-16nvRznP2vLrrYzvgkyqhgCaUs'
  # Secret key used for internal Serverpod service communication
  serviceSecret: 'development_service_secret_placeholder'

test:
  database: '2Xl2nS87DQ8Q8P8YOSkPXM029VsHVX-M'
  redis: 'R0RdMxDnROVc_C3HjfzQawFBcvrWG4zA'
  serviceSecret: 'test_service_secret_placeholder'

staging:
  database: 'your_staging_database_password'
  redis: 'your_staging_redis_password'
  serviceSecret: 'your_staging_service_secret'

production:
  database: 'your_production_database_password'
  redis: 'your_production_redis_password'
  serviceSecret: 'your_production_service_secret'
